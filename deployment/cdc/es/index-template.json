{
  "index_patterns": ["cdc-*"],
  "priority": 500,
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "refresh_interval": "1s"
    },
    "mappings": {
      "dynamic": false,
      "properties": {
        "id":         { "type": "keyword" },
        "customerId": { "type": "keyword" },
        "orderId":    { "type": "keyword" },

        "fullName":    { "type": "text", "fields": { "keyword": { "type": "keyword", "ignore_above": 256 } } },
        "email":       { "type": "keyword" },
        "phone":       { "type": "keyword" },
        "status":      { "type": "keyword" },
        "orderNumber": { "type": "keyword" },
        "currency":    { "type": "keyword" },
        "productName": { "type": "text", "fields": { "keyword": { "type": "keyword", "ignore_above": 256 } } },

        "quantity":    { "type": "integer" },
        "totalAmount": { "type": "scaled_float", "scaling_factor": 100 },
        "unitPrice":   { "type": "scaled_float", "scaling_factor": 100 },

        "createdAt": { "type": "date" },
        "updatedAt": { "type": "date" },

        "_cdc": {
          "properties": {
            "op":         { "type": "keyword" },
            "table":      { "type": "keyword" },
            "lsn":        { "type": "long" },
            "tsMs":       { "type": "long" },
            "indexedAt":  { "type": "date" }
          }
        }
      }
    }
  }
}
