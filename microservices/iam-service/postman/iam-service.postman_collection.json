{
  "info": {
    "_postman_id": "9c1f0b6e-4a3d-4d7a-9d1e-0b8f2a6c5e11",
    "name": "IAM Service",
    "description": "Identity and Access Management service (Spring Authorization Server + REST API + JTE pages).\n\n1. Set `baseUrl`.\n2. Run `OAuth2 > Discovery document` to check the server.\n3. Sign in through `/login` (or use `OAuth2 > Initial access token` + DCR) and paste the access token into `accessToken`.\n4. Every request inherits the Bearer token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{accessToken}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:9026", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "userUuid", "value": "", "type": "string" },
    { "key": "roleUuid", "value": "", "type": "string" },
    { "key": "permissionUuid", "value": "", "type": "string" },
    { "key": "identityUuid", "value": "", "type": "string" },
    { "key": "page", "value": "0", "type": "string" },
    { "key": "size", "value": "20", "type": "string" },
    { "key": "sort", "value": "createdAt,desc", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register user",
          "auth": { "type": "noauth" },
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"sokdara\",\n  \"email\": \"dara.sok@istad.co\",\n  \"password\": \"Str0ng!Pass2026\",\n  \"confirmPassword\": \"Str0ng!Pass2026\",\n  \"givenName\": \"Dara\",\n  \"familyName\": \"Sok\",\n  \"locale\": \"km\"\n}"
            },
            "description": "Public endpoint. Returns 201 with the created user."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('userUuid', pm.response.json().uuid);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Create user",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/users", "host": ["{{baseUrl}}"], "path": ["api", "users"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"sokdara\",\n  \"email\": \"dara.sok@istad.co\",\n  \"password\": \"Str0ng!Pass2026\",\n  \"givenName\": \"Dara\",\n  \"familyName\": \"Sok\",\n  \"gender\": \"male\",\n  \"birthdate\": \"2003-05-20\",\n  \"phoneNumber\": \"+85512345678\",\n  \"zoneinfo\": \"Asia/Phnom_Penh\",\n  \"locale\": \"km\",\n  \"address\": {\n    \"streetAddress\": \"No. 24, St. 562\",\n    \"locality\": \"Toul Kork\",\n    \"region\": \"Phnom Penh\",\n    \"postalCode\": \"120408\",\n    \"country\": \"KH\"\n  },\n  \"roleUuids\": []\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.collectionVariables.set('userUuid', pm.response.json().uuid);"]
              }
            }
          ]
        },
        {
          "name": "List users",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/users?page={{page}}&size={{size}}&sort={{sort}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users"],
              "query": [
                { "key": "page", "value": "{{page}}" },
                { "key": "size", "value": "{{size}}" },
                { "key": "sort", "value": "{{sort}}" }
              ]
            }
          }
        },
        {
          "name": "Get user",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/users/{{userUuid}}", "host": ["{{baseUrl}}"], "path": ["api", "users", "{{userUuid}}"] }
          }
        },
        {
          "name": "Update profile",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/users/{{userUuid}}", "host": ["{{baseUrl}}"], "path": ["api", "users", "{{userUuid}}"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"givenName\": \"Dara\",\n  \"nickname\": \"Dara\",\n  \"phoneNumber\": \"+85512345678\",\n  \"locale\": \"en\"\n}"
            }
          }
        },
        {
          "name": "Delete user",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/api/users/{{userUuid}}", "host": ["{{baseUrl}}"], "path": ["api", "users", "{{userUuid}}"] }
          }
        },
        {
          "name": "Enable user",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/users/{{userUuid}}/enable", "host": ["{{baseUrl}}"], "path": ["api", "users", "{{userUuid}}", "enable"] }
          }
        },
        {
          "name": "Disable user",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/users/{{userUuid}}/disable", "host": ["{{baseUrl}}"], "path": ["api", "users", "{{userUuid}}", "disable"] }
          }
        },
        {
          "name": "Lock user",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/users/{{userUuid}}/lock", "host": ["{{baseUrl}}"], "path": ["api", "users", "{{userUuid}}", "lock"] }
          }
        },
        {
          "name": "Unlock user",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/users/{{userUuid}}/unlock", "host": ["{{baseUrl}}"], "path": ["api", "users", "{{userUuid}}", "unlock"] }
          }
        },
        {
          "name": "Reset password",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/users/{{userUuid}}/password", "host": ["{{baseUrl}}"], "path": ["api", "users", "{{userUuid}}", "password"] },
            "body": { "mode": "raw", "raw": "{\n  \"newPassword\": \"N3w!Pass2026\"\n}" }
          }
        },
        {
          "name": "Get user authorities",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/users/{{userUuid}}/authorities", "host": ["{{baseUrl}}"], "path": ["api", "users", "{{userUuid}}", "authorities"] }
          }
        },
        {
          "name": "Assign roles to user",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/users/{{userUuid}}/roles", "host": ["{{baseUrl}}"], "path": ["api", "users", "{{userUuid}}", "roles"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roleUuids\": [\"{{roleUuid}}\"],\n  \"expiresAt\": \"2026-12-31T23:59:59Z\",\n  \"reason\": \"Temporary admin\"\n}"
            }
          }
        },
        {
          "name": "Revoke role from user",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/users/{{userUuid}}/roles/{{roleUuid}}?reason=Reassigned",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "{{userUuid}}", "roles", "{{roleUuid}}"],
              "query": [{ "key": "reason", "value": "Reassigned" }]
            }
          }
        },
        {
          "name": "Grant permissions to user",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/users/{{userUuid}}/permissions", "host": ["{{baseUrl}}"], "path": ["api", "users", "{{userUuid}}", "permissions"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"permissionUuids\": [\"{{permissionUuid}}\"],\n  \"effect\": \"GRANT\",\n  \"reason\": \"Needs to read reports\"\n}"
            }
          }
        },
        {
          "name": "Revoke permission from user",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/users/{{userUuid}}/permissions/{{permissionUuid}}?reason=No longer needed",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "{{userUuid}}", "permissions", "{{permissionUuid}}"],
              "query": [{ "key": "reason", "value": "No longer needed" }]
            }
          }
        },
        {
          "name": "List user identities",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/users/{{userUuid}}/identities", "host": ["{{baseUrl}}"], "path": ["api", "users", "{{userUuid}}", "identities"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (Array.isArray(body) && body.length) pm.collectionVariables.set('identityUuid', body[0].uuid);"
                ]
              }
            }
          ]
        },
        {
          "name": "Unlink identity",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/api/users/{{userUuid}}/identities/{{identityUuid}}", "host": ["{{baseUrl}}"], "path": ["api", "users", "{{userUuid}}", "identities", "{{identityUuid}}"] }
          }
        }
      ]
    },
