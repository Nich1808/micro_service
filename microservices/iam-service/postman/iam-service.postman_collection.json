    {
      "name": "OAuth2",
      "item": [
        {
          "name": "Discovery document",
          "auth": { "type": "noauth" },
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/.well-known/openid-configuration",
              "host": ["{{baseUrl}}"],
              "path": [".well-known", "openid-configuration"]
            }
          }
        },
        {
          "name": "Initial access token (client_credentials)",
          "auth": {
            "type": "basic",
            "basic": [
              { "key": "username", "value": "dcr-initial-access", "type": "string" },
              { "key": "password", "value": "dcr-secret", "type": "string" }
            ]
          },
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "url": { "raw": "{{baseUrl}}/oauth2/token", "host": ["{{baseUrl}}"], "path": ["oauth2", "token"] },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type", "value": "client_credentials" },
                { "key": "scope", "value": "client.create" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('token issued', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('accessToken', pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Dynamic client registration",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/connect/register", "host": ["{{baseUrl}}"], "path": ["connect", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"client_name\": \"ISTAD E-Commerce Web\",\n  \"redirect_uris\": [\"http://localhost:8081/login/oauth2/code/iam\"],\n  \"grant_types\": [\"authorization_code\", \"refresh_token\"],\n  \"response_types\": [\"code\"],\n  \"scope\": \"openid profile email\",\n  \"token_endpoint_auth_method\": \"client_secret_basic\"\n}"
            },
            "description": "Requires a Bearer token with the client.create scope (see 'Initial access token')."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('registered', () => pm.response.to.have.status(201));"]
              }
            }
          ]
        }
      ]
    }
